{
  "name": "kaleidosync-desktop",
  "version": "2.0.0",
  "description": "Standalone desktop app for Kaleidosync visuals synced to system audio",
  "author": "Brodie",
  "homepage": "https://github.com/brgjr10/kaleidosync",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:native": "bash native/windows/build.sh",
    "build:bundles": "node build-renderer.js && node build-preload.js",
    "extract": "node extractor.js",
    "lint": "eslint . --ext .js,.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "d3-interpolate": "^3.0.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.kaleidosync.desktop",
    "productName": "Kaleidosync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "native/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "native/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "app/assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "app/assets/icon.png"
    }
  }
}